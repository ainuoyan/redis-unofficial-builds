diff --git a/tests/unit/memefficiency.tcl b/tests/unit/memefficiency.tcl
--- a/tests/unit/memefficiency.tcl
+++ b/tests/unit/memefficiency.tcl
@@ -1223,6 +1223,12 @@ run_solo {defrag} {
                 $replica config set active-defrag-cycle-max 75
                 $replica config set active-defrag-ignore-bytes 2mb

+                # Keep the same 512-page allowance as 2 MB on a 4 KB allocator.
+                # Larger pages retain more slab fragmentation even with no keys.
+                if {[string match {*jemalloc*} [s mem_allocator]]} {
+                    set ignore_bytes [expr {max(2 * 1024 * 1024, 512 * [$replica debug mallctl arenas.page])}]
+                    $replica config set active-defrag-ignore-bytes $ignore_bytes
+                }
                 # add a mass of string keys
                 set count 0
                 for {set j 0} {$j < 500000} {incr j} {
@@ -1271,4 +1277,4 @@ run_solo {defrag} {
         }
-    } {} {defrag external:skip tsan:skip debug_defrag:skip cluster}
+    } {} {defrag external:skip tsan:skip debug_defrag:skip cluster needs:debug}

     start_cluster 1 0 {tags {"defrag external:skip tsan:skip debug_defrag:skip cluster needs:debug"} overrides {appendonly yes auto-aof-rewrite-percentage 0 save "" loglevel notice}} {
