# Managed by redis-unofficial-builds
[Unit]
Description=Redis in-memory data store
Documentation=https://redis.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=redis
Group=redis
WorkingDirectory=/usr/local/redis
ExecStart=/usr/local/redis/bin/redis-server /usr/local/redis/conf/redis.conf --daemonize no
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
# A shutdown may flush a large RDB/AOF to disk; allow it ten minutes before
# SIGKILL so the final save is not truncated. Tune per dataset with a drop-in.
TimeoutStopSec=600s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
RemainAfterExit=no
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
